---
/**
 * MANIFESTO — studio intro with the "5 greșeli" principles as large
 * numbered statements and a floating image pair.
 */
import { Image } from 'astro:assets';
import type { SectionCopy, Tone } from '../../config/sections';
import { site } from '../../config/site';
import { principles } from '../../data/studio';
import { img } from '../../lib/images';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  id?: string;
  tone?: Tone;
  copy?: SectionCopy;
}
const { id, tone = 'paper', copy = {} } = Astro.props;
---

<Section id={id} tone={tone} class="linen overflow-hidden">
  <div class="grid grid-cols-1 gap-16 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <SectionHeading eyebrow={copy.eyebrow} title={copy.title ?? ''} accent={copy.accent} intro={copy.intro} class="!mb-10" />

      <!-- Designer signature (src/config/site.ts → designer) -->
      <div class="mb-14 flex items-start gap-5 rounded-[1.5rem] border border-line bg-card/70 p-6" data-reveal="up">
        <span class="grid size-14 shrink-0 place-items-center rounded-full bg-terra-500 font-display text-2xl text-paper-50 italic">
          {site.designer.name.charAt(0)}
        </span>
        <div>
          <p class="font-display text-2xl leading-tight">{site.designer.name}</p>
          <p class="text-[0.62rem] font-semibold tracking-[0.28em] text-terra-500 uppercase">{site.designer.role}</p>
          <p class="mt-3 leading-relaxed text-muted">{site.designer.bio}</p>
        </div>
      </div>
      <p class="mb-10 text-[0.65rem] font-semibold tracking-[0.3em] text-terra-500 uppercase" data-reveal="fade">
        Ce nu facem niciodată
      </p>
      <ol class="divide-y divide-line border-y border-line" data-stagger="90">
        {
          principles.map((p, i) => (
            <li class="group grid grid-cols-[3rem_1fr] gap-4 py-6 md:grid-cols-[4rem_1fr]" data-reveal="up">
              <span class="font-display text-3xl font-light text-terra-500 italic">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="font-display text-2xl leading-tight font-medium transition-transform duration-500 ease-(--ease-out-expo) group-hover:translate-x-2 md:text-[1.7rem]">{p.title}</h3>
                <p class="mt-2 max-w-xl text-muted">{p.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Image composition -->
    <div class="relative min-h-[34rem] lg:col-span-5">
      <figure class="absolute top-0 right-0 w-[78%] overflow-hidden rounded-t-full" data-reveal="clip">
        <Image src={img('rooms/room-living-terracotta.jpg')} alt="Living cu arcade, terracotta și forme organice" widths={[480, 800]} sizes="(min-width:1024px) 30vw, 78vw" class="aspect-[3/4] w-full object-cover" />
      </figure>
      <figure class="absolute bottom-0 left-0 w-[50%] overflow-hidden rounded-[1.25rem] border-[6px] border-surface shadow-2xl" data-reveal="zoom" style="--reveal-delay:250ms">
        <Image src={img('rooms/room-curtains.jpg')} alt="Perdele până în podea și calorifer camuflat" widths={[320, 520]} sizes="20rem" class="aspect-square w-full object-cover" />
      </figure>
      <div class="absolute bottom-[18%] -right-2 grid size-28 animate-float place-items-center rounded-full bg-terra-500 p-4 text-center text-[0.55rem] leading-tight font-semibold tracking-[0.2em] text-paper-50 uppercase md:-right-6" data-reveal="zoom" style="--reveal-delay:450ms">
        Casa ta.<br />Nu un showroom.
      </div>
    </div>
  </div>

  <p class="mt-20 text-center font-display text-[clamp(1.6rem,3.2vw,2.6rem)] font-light italic" data-reveal="up">„{site.tagline}.”</p>
</Section>
