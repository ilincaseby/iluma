---
/**
 * PROCESS — 5 steps along a line that "draws" itself as you scroll
 * (src/scripts/modules/drawline.ts writes --p on [data-drawline]).
 */
import type { SectionCopy, Tone } from '../../config/sections';
import { process } from '../../data/studio';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  id?: string;
  tone?: Tone;
  copy?: SectionCopy;
}
const { id, tone = 'stone', copy = {} } = Astro.props;
---

<Section id={id} tone={tone}>
  <SectionHeading eyebrow={copy.eyebrow} title={copy.title ?? 'Proces'} accent={copy.accent} intro={copy.intro} />

  <ol class="relative grid grid-cols-1 gap-10 md:grid-cols-5 md:gap-6" data-drawline style="--p:0">
    <!-- The line -->
    <span class="absolute top-6 left-6 hidden h-px w-[calc(100%-3rem)] bg-line md:block" aria-hidden="true"></span>
    <span class="absolute top-6 left-6 hidden h-px w-[calc(100%-3rem)] origin-left bg-terra-500 md:block" style="transform:scaleX(var(--p))" aria-hidden="true"></span>
    <span class="absolute top-6 bottom-6 left-6 w-px bg-line md:hidden" aria-hidden="true"></span>
    <span class="absolute top-6 bottom-6 left-6 w-px origin-top bg-terra-500 md:hidden" style="transform:scaleY(var(--p))" aria-hidden="true"></span>

    {
      process.map((s, i) => (
        <li class="relative pl-20 md:pl-0" data-reveal="up" style={`--reveal-delay:${i * 110}ms`}>
          <span class="absolute top-0 left-0 grid size-12 place-items-center rounded-full border border-line bg-surface font-display text-lg italic md:relative">
            {s.n}
          </span>
          <h3 class="font-display text-2xl leading-tight font-medium md:mt-8">{s.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">{s.text}</p>
        </li>
      ))
    }
  </ol>
</Section>
