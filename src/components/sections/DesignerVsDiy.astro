---
/**
 * DESIGNER vs DIY — two cards that flip in 3D on hover / tap (from the
 * "Designer sau DIY?" carousel), plus their conclusion.
 */
import type { SectionCopy, Tone } from '../../config/sections';
import { designerVsDiy as d } from '../../data/studio';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  id?: string;
  tone?: Tone;
  copy?: SectionCopy;
}
const { id, tone = 'dark', copy = {} } = Astro.props;
const cards = [
  { ...d.designer, icon: 'pencil-ruler', front: 'bg-terra-500' },
  { ...d.diy, icon: 'hammer', front: 'bg-olive-500' },
];
---

<Section id={id} tone={tone}>
  <SectionHeading eyebrow={copy.eyebrow} title={copy.title ?? ''} accent={copy.accent} align="center" />

  <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 [perspective:1600px] md:grid-cols-2">
    {
      cards.map((c, i) => (
        <button
          type="button"
          class="group relative h-[26rem] w-full text-left [transform-style:preserve-3d]"
          data-reveal="up"
          style={`--reveal-delay:${i * 150}ms`}
          data-flip
          aria-label={`${c.title}: ${c.lead} ${c.points.join(', ')}`}
        >
          <div class="absolute inset-0 transition-transform duration-[900ms] ease-(--ease-out-expo) [transform-style:preserve-3d] group-hover:[transform:rotateY(180deg)] group-data-[flipped]:[transform:rotateY(180deg)]">
            {/* Front */}
            <div class:list={['absolute inset-0 flex flex-col justify-between rounded-[1.75rem] p-9 text-paper-50 [backface-visibility:hidden]', c.front]}>
              <Icon name={c.icon} size={30} strokeWidth={1.3} />
              <div>
                <p class="font-display text-7xl font-light">{c.title}</p>
                <p class="mt-3 flex items-center gap-2 text-sm tracking-[0.2em] uppercase opacity-80">
                  Întoarce <Icon name="arrow-right" size={14} />
                </p>
              </div>
            </div>
            {/* Back */}
            <div class="absolute inset-0 flex flex-col justify-center rounded-[1.75rem] border border-paper-100/15 bg-espresso-800 p-9 [backface-visibility:hidden] [transform:rotateY(180deg)]">
              <p class="title-caps text-[0.8rem] text-wood-300">{c.lead}</p>
              <ul class="mt-6 space-y-4">
                {c.points.map((p) => (
                  <li class="flex gap-3 font-display text-xl leading-snug">
                    <Icon name="check" size={18} class="mt-1 shrink-0 text-wood-300" />
                    {p}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </button>
      ))
    }
  </div>

  <div class="mx-auto mt-16 max-w-3xl text-center" data-reveal="up">
    <p class="title-caps text-[0.75rem] text-wood-300">Concluzie</p>
    <p class="mt-5 font-display text-[clamp(1.6rem,3vw,2.4rem)] leading-snug font-light">{d.conclusion}</p>
    <p class="mt-5 font-display text-xl text-paper-100/70 italic">{d.quote}</p>
  </div>
</Section>
