---
/**
 * FOOTER — big motto, links, contact and Instagram.
 * Everything comes from src/config.
 */
import { site } from '../../config/site';
import { mainNav } from '../../config/navigation';
import { guides } from '../../data/guides';
import { navHref, url, contactHref, contactIsExternal, whatsappHref } from '../../lib/utils';
import Logo from './Logo.astro';
import Icon from '../ui/Icon.astro';

const year = new Date().getFullYear();
---

<footer class="tone-dark grain relative overflow-hidden bg-espresso-950 text-paper-100">
  <div class="container-x relative pt-24 pb-10">
    <!-- Motto from their palette reel -->
    <p class="max-w-4xl font-display text-[clamp(2rem,5vw,4rem)] leading-[1.05] font-light italic" data-reveal="up">
      „{site.motto}”
    </p>

    <div class="mt-20 grid grid-cols-1 gap-12 border-t border-paper-100/10 pt-14 md:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Logo light />
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-paper-100/65">{site.description}</p>
      </div>

      <nav aria-label="Link-uri subsol" class="lg:col-span-2">
        <p class="mb-5 text-[0.65rem] font-semibold tracking-[0.3em] text-wood-300 uppercase">Navigare</p>
        <ul class="space-y-3 text-sm">
          {mainNav.map((l) => <li><a href={navHref(l.href)} class="text-paper-100/70 transition-colors hover:text-paper-50">{l.label}</a></li>)}
        </ul>
      </nav>

      <div class="lg:col-span-3">
        <p class="mb-5 text-[0.65rem] font-semibold tracking-[0.3em] text-wood-300 uppercase">Înainte să cumperi…</p>
        <ul class="space-y-3 text-sm">
          {guides.map((g) => <li><a href={url(`/ghiduri/${g.slug}`)} class="text-paper-100/70 transition-colors hover:text-paper-50">{g.title}</a></li>)}
        </ul>
      </div>

      <div class="lg:col-span-3">
        <p class="mb-5 text-[0.65rem] font-semibold tracking-[0.3em] text-wood-300 uppercase">Contact</p>
        <ul class="space-y-4 text-sm text-paper-100/75">
          <li class="flex gap-3"><Icon name="map-pin" size={17} class="mt-0.5 text-wood-300" />{site.city}</li>
          {site.phone && <li><a href={`tel:${site.phone.e164}`} class="flex gap-3 hover:text-paper-50"><Icon name="phone" size={17} class="mt-0.5 text-wood-300" />{site.phone.display}</a></li>}
          {whatsappHref() && <li><a href={whatsappHref()!} target="_blank" rel="noopener noreferrer" class="flex gap-3 hover:text-paper-50"><Icon name="whatsapp" size={17} class="mt-0.5 text-wood-300" />WhatsApp</a></li>}
          {site.email && <li><a href={`mailto:${site.email}`} class="flex gap-3 break-all hover:text-paper-50"><Icon name="mail" size={17} class="mt-0.5 text-wood-300" />{site.email}</a></li>}
          <li>
            <a href={site.instagram.url} target="_blank" rel="noopener noreferrer" class="flex gap-3 hover:text-paper-50">
              <Icon name="instagram" size={17} class="mt-0.5 text-wood-300" />{site.instagram.handle}
            </a>
          </li>
          <li>
            <a href={contactHref()} {...(contactIsExternal() ? { target: '_blank', rel: 'noopener noreferrer' } : {})} class="inline-flex items-center gap-2 border-b border-wood-300 pb-1 text-paper-50">
              Hai să vorbim <Icon name="arrow-up-right" size={15} />
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Giant wordmark -->
    <p class="pointer-events-none mt-16 text-center font-display text-[22vw] leading-[0.8] font-light tracking-[0.18em] text-paper-100/[0.06] select-none" aria-hidden="true">
      ILUMA
    </p>

    <div class="mt-6 flex flex-col items-center justify-between gap-3 border-t border-paper-100/10 pt-6 text-xs text-paper-100/50 md:flex-row">
      <p>© {year} {site.name}. Toate drepturile rezervate.</p>
      <p class="tracking-[0.2em] uppercase">{site.tagline}</p>
    </div>
  </div>
</footer>
