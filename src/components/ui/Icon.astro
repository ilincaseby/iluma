---
/**
 * <Icon name="scissors" />
 * ----------------------------------------------------------------------------
 * One icon component for the whole site.
 *  • Any Lucide icon by its kebab-case name (https://lucide.dev/icons)
 *  • Plus custom brand icons below (Lucide doesn't ship brand logos).
 * Icons render as inline SVG at build time — zero client-side JavaScript.
 */
import { icons } from '@lucide/astro';

interface Props {
  name: string;
  size?: number | string;
  class?: string;
  strokeWidth?: number;
  /** Accessible label; when omitted the icon is decorative (aria-hidden) */
  label?: string;
}

const { name, size = 20, class: className, strokeWidth = 1.6, label } = Astro.props;

/* Custom brand icons (filled, 24×24 viewBox) */
