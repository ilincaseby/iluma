/** "scan-face" → "ScanFace" (Lucide export naming) */
const toPascal = (s: string) =>
  s
    .split('-')
    .map((p) => p.charAt(0).toUpperCase() + p.slice(1))
    .join('');

const brandPath = brands[name];
const Lucide = !brandPath ? (icons as Record<string, any>)[toPascal(name)] : null;

if (!brandPath && !Lucide) {
  console.warn(`[Icon] Unknown icon "${name}" — see https://lucide.dev/icons`);
}

const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---

{
  brandPath ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="currentColor"
      class:list={['shrink-0', className]}
      {...a11y}
    >
      <path d={brandPath} />
    </svg>
  ) : Lucide ? (
    <Lucide size={size} stroke-width={strokeWidth} class:list={['shrink-0', className]} {...a11y} />
  ) : null
}
