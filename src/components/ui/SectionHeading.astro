---
/**
 * <SectionHeading eyebrow="…" title="…" accent="…" intro="…" />
 * Title block used by every section — a wide-tracked eyebrow (like the
 * carousel titles) + large serif headline. Default slot = right-side content.
 */
import SplitText from './SplitText.astro';

interface Props {
  eyebrow?: string;
  title: string;
  accent?: string;
  intro?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
  class?: string;
}

const { eyebrow, title, accent, intro, align = 'left', as = 'h2', class: className } = Astro.props;
const centered = align === 'center';
---

<div
  class:list={[
    'mb-14 flex flex-col gap-8 md:mb-20',
    centered ? 'items-center text-center' : 'md:flex-row md:items-end md:justify-between',
    className,
  ]}
>
  <div class:list={['max-w-3xl', centered && 'mx-auto']}>
    {
      eyebrow && (
        <p data-reveal="fade" class:list={['mb-6 flex items-center gap-4 text-[0.68rem] font-semibold tracking-[0.34em] text-accent uppercase', centered && 'justify-center']}>
          <span class="h-px w-10 bg-current" aria-hidden="true" />
          {eyebrow}
        </p>
      )
    }
    <SplitText
      as={as}
      text={title}
      accent={accent}
      class="font-display text-[clamp(2.5rem,6vw,5rem)] leading-[1] font-light tracking-[-0.01em] text-balance text-fg"
    />
    {
      intro && (
        <p data-reveal="up" style="--reveal-delay:200ms" class:list={['mt-7 max-w-2xl text-lg leading-relaxed text-pretty text-muted', centered && 'mx-auto']}>
          {intro}
        </p>
      )
    }
  </div>
  {Astro.slots.has('default') && <div data-reveal="up" class="shrink-0"><slot /></div>}
</div>
